<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>preview-All</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Web.BrowserLink" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <!-- BlazorRogue.Tests and tools/ (AtlasPacker, the licensed-tileset atlas packer) live in
         subfolders of this project; exclude them from the Web SDK's default recursive globbing so
         their files aren't compiled into this project too. -->
    <Compile Remove="BlazorRogue.Tests\**" />
    <Content Remove="BlazorRogue.Tests\**" />
    <None Remove="BlazorRogue.Tests\**" />
    <Compile Remove="tools\**" />
    <Content Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allows the test project to set internal-setter statics like References.SoundManager,
         mirroring how app code (e.g. Pages/GamePage.razor) wires them up at runtime. -->
    <InternalsVisibleTo Include="BlazorRogue.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuration.cs resolves these relative to AppContext.BaseDirectory, so they must ship
         next to the built assembly (build output and publish output alike). -->
    <None Include="Data\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
