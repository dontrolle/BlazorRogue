<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>preview-All</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Web.BrowserLink" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <!-- BlazorRogue.Tests lives in a subfolder of this project; exclude it from the Web SDK's
         default recursive globbing so its files aren't compiled into this project too. -->
    <Compile Remove="BlazorRogue.Tests\**" />
    <Content Remove="BlazorRogue.Tests\**" />
    <None Remove="BlazorRogue.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allows the test project to set internal-setter statics like References.SoundManager,
         mirroring how app code (e.g. Pages/Indoor.razor) wires them up at runtime. -->
    <InternalsVisibleTo Include="BlazorRogue.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuration.cs resolves these relative to AppContext.BaseDirectory, so they must ship
         next to the built assembly (build output and publish output alike). -->
    <None Include="Data\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Licensed Ultimate Fantasy tileset (wwwroot/img/uf_*, see README "Tileset") - present only
         on machines that own a license, gitignored and dockerignored otherwise. `dotnet publish`
         already mirrors it via the normal static web assets pipeline, but Indoor.razor's tileset
         auto-detection checks WebHostEnvironment.WebRootPath, which for a plain `dotnet build`
         output points at bin/.../wwwroot - so mirror it there too when present. When absent, this
         glob simply matches nothing. Docker's exclusion is unaffected: .dockerignore strips these
         files from the build context before any csproj item ever sees them. -->
    <None Include="wwwroot\img\uf_*\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
