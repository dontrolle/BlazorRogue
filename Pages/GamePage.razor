@page "/"

@using System.IO
@using System.Linq
@using Microsoft.AspNetCore.Hosting
@using Microsoft.JSInterop
@using BlazorRogue.Effects
@using BlazorRogue.Sessions
@using BlazorRogue.World
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime;
@inject IWebHostEnvironment WebHostEnvironment;
@inject GameSessionStore Sessions;

@{
    int gridTileSize = renderAscii ? asciiGridTileSize : graphicGridTileSize;
    string mapStyle = $"grid-template-rows: repeat({windowHeight}, {gridTileSize}px); grid-template-columns: repeat({windowWidth}, {gridTileSize}px);";

    const string shakeClass = "shakehit0";
    string mapClass = "map";
    string spanClass = "";
    if (session is not null && game.EffectsSystem.Shake)
    {
        if (tikTok)
        {
            mapClass = $"{mapClass} {shakeClass}";
        }
        else
        {
            spanClass = $"{shakeClass}";
        }
    }
    tikTok = !tikTok;
}

@if (session is null)
{
    <div class="main_window">
        <p>Loading&hellip;</p>
    </div>
}
else
{
<div class="main_window">
    <div id="left_menu" class="left_menu">
        @if (confirmNewGame)
        {
            <button type="button" id="new_game_confirm" class="toggle_button" @onclick="StartNewGame">Discard game?</button>
            <button type="button" id="new_game_cancel" class="toggle_button" @onclick="CancelNewGame">Cancel</button>
        }
        else
        {
            <button type="button" id="new_game" class="toggle_button @(game.Map.IsGameOver ? "highlighted" : "")" @onclick="RequestNewGame">New game</button>
        }
        <br />
        <div id="debuginfo" class="debuginfo">
            @foreach (var debugInfo in game.Map.DebugInfo)
            {
                <p>@debugInfo</p>
            }
            @{
                var wounds = game.Map.Player.CombatComponent!.Wounds;
                var maxWounds = game.Map.Player.CombatComponent!.MaxWounds;
                var isDead = wounds <= 0;
                var healthBar = ComputeHealthBarMetrics(wounds, maxWounds);
            }
            @{
                var gold = game.Map.Player.InventoryComponent!.Gold;
            }
            @if (renderAscii)
            {
                <div class="stat-text"><span>Health</span><span>@wounds/@maxWounds</span></div>
                <div class="stat-text"><span>Gold</span><span>@gold</span></div>
                <div class="stat-text"><span>Attack</span><span>@game.Map.Player.CombatComponent!.WeaponSkill</span></div>
                <div class="stat-text"><span>Damage</span><span>@game.Map.Player.CombatComponent!.WeaponDamage</span></div>
                <div class="stat-text"><span>Defense</span><span>@game.Map.Player.CombatComponent!.DamageSoak</span></div>
            }
            else
            {
                <div class="stat-icon" data-tool-tip="Health">
                    <div class="health-bar">
                        @if (isDead)
                        {
                            <img class="health-bar-base" src="/img/ui/blood_meter_empty.png" alt="Health" />
                        }
                        else
                        {
                            <img class="health-bar-base" src="/img/ui/blood_meter_full.png" alt="Health" />
                            @if (healthBar.ShowDrain)
                            {
                                <img class="health-bar-cap" src="/img/ui/blood_meter_empty_right_end.png" alt="" />
                                @if (healthBar.GreyStripWidthPx > 0)
                                {
                                    <div class="health-bar-strip" style="width:@(healthBar.GreyStripWidthPx)px;"></div>
                                }
                                @if (healthBar.ShowBoundaryMarker)
                                {
                                    <img
                                        class="health-bar-marker"
                                        src="/img/ui/blood_meter_strip_full_right_end.png"
                                        alt=""
                                        style="right:@(healthBar.BoundaryMarkerRightPx)px;"
                                    />
                                }
                            }
                        }
                    </div>
                    <span>@wounds/@maxWounds</span>
                </div>
                <div class="stat-icon" data-tool-tip="Gold">
                    <img src="/img/ui/gold_@(gold == 0 ? "empty" : "full").png" alt="Gold" />
                    <span>@gold</span>
                </div>
                <div class="stat-icon" data-tool-tip="Attack skill">
                    <img src="/img/ui/skills_attack_gray.png" alt="Attack" />
                    <span>@game.Map.Player.CombatComponent!.WeaponSkill</span>
                </div>
                <div class="stat-icon" data-tool-tip="Damage">
                    <img src="/img/ui/skills_damage_gray.png" alt="Damage" />
                    <span>@game.Map.Player.CombatComponent!.WeaponDamage</span>
                </div>
                <div class="stat-icon" data-tool-tip="Defense">
                    <img src="/img/ui/skill_defense_gray.png" alt="Defense" />
                    <span>@game.Map.Player.CombatComponent!.DamageSoak</span>
                </div>
            }
        </div>
        <div class="instructions">
            Press <tt>?</tt> for help
        </div>
    </div>

    <span class="@spanClass">
        <div class="@mapClass" style="@mapStyle" id="mapcontainer">
            <!-- map is rendered row by row, top to bottom -->
            @for (int wY = 0; wY < windowHeight; wY++)
            {
                @for (int wX = 0; wX < windowWidth; wX++)
                {
                    int x = wX + windowXOffset;
                    int y = wY + windowYOffset;

                    Tile tile = game.Map.Tiles[x, y];
                    string character = tile.Character;
                    string charactercolor = tile.CharacterColor;
                    string imgFileName = tile.ImageName + ".png";
                    string tiletype = tile.TileType.ToString();
                    string fovClass = game.Map.IsVisibleMap[x, y] ? "" : "outoffov";
                    string tileClass = $"tile {(fovClass)}";
                    string cellClass = "cell";

                    <div id="@x,@y" class="@cellClass">
                        @if (game.Map.IsMappedMap[x, y])
                        {
                            if (renderAscii)
                            {
                                <div class="@tileClass" style="color:@charactercolor" alt="@x,@y (@tiletype)">@character</div>
                            }
                            else
                            {
                                <div class="@tileClass" style="background-image: url('img/uf_terrain/@imgFileName')"
                                     alt="@x,@y (@tiletype)"> </div>
                            }

                            @foreach (var decoration in game.Map.AllDecorations(x, y))
                            {
                                // skip invisibles outside of fov
                                if (decoration.GameObject.InvisibleOutsideFov && !game.Map.IsVisibleMap[x, y])
                                {
                                    continue;
                                }

                                bool renderDiv = false;
                                string baseCssClass = "decoration";
                                string animationClass = "";
                                string style = "";
                                string divContent = "";

                                // - handle layer class
                                string layerClass;
                                layerClass = decoration.DecorationLayer switch
                                {
                                    Decoration.Layer.Infront => "decinfront",
                                    Decoration.Layer.Middleground => "decmiddle",
                                    Decoration.Layer.Behind => "decbehind",
                                    _ => throw new InvalidOperationException("Unhandled Decoration.Layer value.")
                                };

                                if (renderAscii)
                                {
                                    baseCssClass += " decoration-ascii";
                                    // weed out those decorations, which shouldn't be shown in ascii
                                    if (!String.IsNullOrEmpty(decoration.Character))
                                    {
                                        renderDiv = true;
                                        divContent = decoration.Character;
                                        style = $"color:{decoration.CharacterColor ?? "white"}";
                                    }
                                }
                                else
                                {
                                    // determine css class
                                    if (decoration.AnimationClass != null && decoration.AnimationClass != "")
                                    {
                                        animationClass = @decoration.AnimationClass;
                                        renderDiv = true;
                                    }

                                    // determine css style
                                    if (decoration.ImageName != null && decoration.ImageName != "")
                                    {
                                        string decImgFileName = decoration.ImageName + ".png";

                                        renderDiv = true;
                                        style = $"background-image: url('img/{decoration.ImageFolder}/{decImgFileName}');";
                                    }

                                    // - handle horizontal and vertical offset
                                    string offset = "";
                                    string opacityValue = "1";
                                    if (decoration.VerticalOffset != 0)
                                    {
                                        // are there any decorations already on the tile we are going to put an offset decoration on top off
                                        if (game.Map.Decorations[x, y + decoration.VerticalOffset].Any(d => d.MakeCoveringOffsetDecsTransparent) || game.Map.MoveableDecorations[x, y + decoration.VerticalOffset].Any())
                                        {
                                            opacityValue = "0.5";
                                        }
                                        offset = $"top: {decoration.VerticalOffset * gridTileSize}px;";
                                    }
                                    if (decoration.HorizontalOffset != 0)
                                    {
                                        // are there any decorations already on the tile we are going to put an offset decoration on top off
                                        if (game.Map.Decorations[x + decoration.HorizontalOffset, y].Any(d => d.MakeCoveringOffsetDecsTransparent) || game.Map.MoveableDecorations[x, y + decoration.HorizontalOffset].Any())
                                        {
                                            opacityValue = "0.5";
                                        }
                                        offset += $"left: {decoration.HorizontalOffset * gridTileSize}px;";
                                    }

                                    style = $"{style}{offset}; opacity:{opacityValue};";
                                }

                                if (renderDiv)
                                {
                                    string pausedClass = decoration.AnimationPaused ? "animation-paused" : "";
                                    baseCssClass = $"{baseCssClass} {(animationClass)} {(layerClass)} {(fovClass)} {(pausedClass)}";

                                    string? datatooltip = null;
                                    string infoText = decoration.GameObject.InfoText;
                                    if (!String.IsNullOrEmpty(infoText))
                                    {
                                        datatooltip = infoText;
                                    }

                                    <div class="@baseCssClass" style="@style" data-tool-tip="@datatooltip"
                                         alt="@x,@y (Name=@decoration.GameObject.Name, Blocking=@decoration.GameObject.Blocking)">
                                        @divContent
                                    </div>
                                }
                            }
                        }
                    </div>
                }
            }

            @if (game.Map.IsGameOver)
            {
                <div class="game_over">Game over</div>
            }
        </div>
    </span>

    <div class="message_log">
        @foreach (var message in game.Messages)
        {
            <div class="message_log_entry">@message</div>
        }
    </div>

    @if (showHelp)
    {
        <div class="help_backdrop" @onclick="CloseHelp">
            <div class="help_modal" @onclick:stopPropagation="true">
                <h1>Help</h1>
                <div class="help_columns">
                    <section>
                        <h3>New Game</h3>
                        <dl>
                            <dt>New game</dt>
                            <dd>Use the <b>New game</b> button</dd>
                        </dl>
                    </section>
                    <section>
                        <h3>Movement</h3>
                        <dl>
                            <dt>Move</dt>
                            <dd><tt>&lt;Numkey&gt;</tt> or <tt>qwe/ad/zxc</tt></dd>
                        </dl>
                    </section>
                    <section>
                        <h3>Attack</h3>
                        <dl>
                            <dt>Attack</dt>
                            <dd>Move into a monster</dd>
                        </dl>
                    </section>
                    <section>
                        <h3>Rest</h3>
                        <dl>
                            <dt>Wait</dt>
                            <dd><tt>5</tt> or <tt>s</tt> &mdash; skip a turn in place</dd>
                        </dl>
                    </section>
                    <section>
                        <h3>Use</h3>
                        <dl>
                            <dt>Use</dt>
                            <dd><tt>&lt;Shift&gt;+Move</tt> &mdash; doors, chests, etc.</dd>
                        </dl>
                    </section>
                    <section>
                        <h3>View</h3>
                        <dl>
                            <dt>Toggle graphics</dt>
                            <dd><tt>&lt;Ctrl&gt;+A</tt> &mdash; switch between ASCII and tileset</dd>
                        </dl>
                    </section>
                </div>
                <p class="help_dismiss_hint">Press any key to close</p>
            </div>
        </div>
    }
</div>
}

<audio id="bgsound" loop>
    <source type="audio/mpeg">
</audio>

@code {
    private DotNetObjectReference<GamePage>? _selfRef;
    private bool _resizeHandlingInProgress;

    private sealed record HealthBarMetrics(
        bool ShowDrain,
        int GreyStripWidthPx,
        bool ShowBoundaryMarker,
        int BoundaryMarkerRightPx
    );

    // blood_meter_full.png is 48x16 with a 42px-wide fill area. blood_meter_empty_right_end.png (4px)
    // is shaped to replace the bar's rounded right corner, so it sits flush at the bar's rightmost
    // position - unconditionally, in its own fixed 4px zone - as soon as any wound is lost; that
    // alone is the first visual sliver. Beyond that, empty strips tile in to its left, using up to
    // the full 42px fill for marker + strips, and a copy of blood_meter_strip_full_right_end.png
    // sits at the far edge of that tiled run, bridging back into whatever plain fill remains.
    private static HealthBarMetrics ComputeHealthBarMetrics(int wounds, int maxWounds)
    {
        const int FillWidthNative = 42;
        const int CapWidthNative = 4;
        const int MarkerWidthNative = 1;
        const int Scale = 2;

        if (maxWounds <= 0 || wounds >= maxWounds)
        {
            return new HealthBarMetrics(false, 0, false, 0);
        }

        // Anchored at Wounds=1, not 0 - 0 or below means dead, so spending the meter's full drain
        // range on the invisible 1-to-0 transition would waste resolution that matters more while
        // the player is still alive. This makes Wounds=1 use the entire 42px fill for the drain.
        int effectiveWounds = Math.Max(wounds, 1);
        int lost = maxWounds - effectiveWounds;
        int scaleDenominator = Math.Max(maxWounds - 1, 1);

        int drainedNative = (int)
            Math.Round(lost / (double)scaleDenominator * FillWidthNative, MidpointRounding.AwayFromZero);
        drainedNative = Math.Clamp(drainedNative, 0, FillWidthNative);

        int greyNative = Math.Max(0, drainedNative - MarkerWidthNative);
        bool showBoundaryMarker = drainedNative > 0;
        int boundaryRightNative = CapWidthNative + greyNative;

        return new HealthBarMetrics(
            true,
            greyNative * Scale,
            showBoundaryMarker,
            boundaryRightNative * Scale
        );
    }

    [JSInvokable]
    public async Task OnBrowserResized()
    {
        if (_resizeHandlingInProgress || session is null)
            return;

        _resizeHandlingInProgress = true;
        try
        {
            await FitMapToViewportAsync();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _resizeHandlingInProgress = false;
        }
    }

    private sealed class MapArea
    {
        public int AvailableWidth { get; set; }
        public int AvailableHeight { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The SoundManager wraps this circuit's IJSRuntime, so it is created per circuit and handed
        // to the session on activation rather than being stored on the (longer-lived) session.
        soundManager = new SoundManager(JsRuntime);

        // The browser keeps a stable id in localStorage; that is what lets the server hand back the
        // game already in progress rather than generating a new dungeon. JS interop is unavailable
        // until after the first render, which is why the session is resolved here and not in
        // OnInitialized.
        string sessionId = await JsRuntime.InvokeAsync<string>("blazorroguefuncs.ensureSessionId");

        session = Sessions.GetOrCreate(sessionId);
        game = session.Game;
        session.Activate(soundManager);
        soundManager.PlayBackgroundMusic(
            game.Configuration.Levels[game.CurrentLevelNumber].BackgroundSoundtrack
        );

        // A stored preference only applies when the tileset is actually installed.
        renderAscii = !tilesetAvailable || session.PreferAscii;

        CenterViewportOnPlayer();
        await FitMapToViewportAsync();

        _selfRef = DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync("blazorViewport.registerResize", _selfRef);
        await JsRuntime.InvokeVoidAsync("blazorroguefuncs.registerKeyup", _selfRef);

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("blazorViewport.unregisterResize");
            await JsRuntime.InvokeVoidAsync("blazorroguefuncs.unregisterKeyup");
        }
        catch
        {
            // ignore if JS runtime/page already gone
        }

        _selfRef?.Dispose();
    }

    private async Task FitMapToViewportAsync()
    {
        var area = await JsRuntime.InvokeAsync<MapArea>(
            "blazorViewport.getAvailableMapArea",
            "mapcontainer", // map div id
            "left_menu", // left panel id
            "debuginfo"       // debug panel id
        );

        int tileSize = renderAscii ? asciiGridTileSize : graphicGridTileSize;

        // enforce a sane minimum so game remains playable
        const int minTilesX = 8;
        const int minTilesY = 8;

        int tilesX = Math.Max(minTilesX, area.AvailableWidth / tileSize);
        int tilesY = Math.Max(minTilesY, area.AvailableHeight / tileSize);

        windowWidth = Math.Clamp(tilesX, minTilesX, game.Map.Width);
        windowHeight = Math.Clamp(tilesY, minTilesY, game.Map.Height);

        // re-center viewport around player
        int optimalXOffset = game.Map.Player.X - windowWidth / 2;
        windowXOffset = Math.Clamp(optimalXOffset, 0, game.Map.Width - windowWidth);

        int optimalYOffset = game.Map.Player.Y - windowHeight / 2;
        windowYOffset = Math.Clamp(optimalYOffset, 0, game.Map.Height - windowHeight);

        // optional: keep move buffer proportional after resize
        windowMoveBufferX = Math.Min(Map.PlayerSightRadius + 1, Math.Max(1, windowWidth / 3));
        windowMoveBufferY = Math.Min(Map.PlayerSightRadius + 1, Math.Max(1, windowHeight / 3));
    }

    private async Task ToggleRenderMode()
    {
        renderAscii = !renderAscii;

        if (session is not null)
        {
            session.PreferAscii = renderAscii;
        }

        await FitMapToViewportAsync();
    }

    // Once the game is over there is no progress left to protect, so skip straight past the confirm
    // step - the button is the only thing the player can still do.
    async Task RequestNewGame()
    {
        if (session is not null && game.Map.IsGameOver)
        {
            await StartNewGame();
            return;
        }

        confirmNewGame = true;
    }

    void CancelNewGame() => confirmNewGame = false;

    // Progress now survives reloads, so discarding it deserves a deliberate second click.
    async Task StartNewGame()
    {
        confirmNewGame = false;

        session!.StartNewGame();
        game = session.Game;
        session.Activate(soundManager!);
        soundManager!.PlayBackgroundMusic(
            game.Configuration.Levels[game.CurrentLevelNumber].BackgroundSoundtrack
        );

        CenterViewportOnPlayer();
        await FitMapToViewportAsync();
    }

    bool renderAscii = false;
    const int asciiGridTileSize = 20;
    const int graphicGridTileSize = 48;
    bool tikTok = false;
    bool tilesetAvailable;
    bool confirmNewGame;
    bool showHelp;

    void CloseHelp() => showHelp = false;

    GameSession? session;
    SoundManager? soundManager;

    // Both are assigned alongside `session` once the browser's session id is known; the markup is
    // guarded on `session is null` so neither is dereferenced before that.
    Game game = null!;

    int windowMoveBufferX = Map.PlayerSightRadius + 1;
    int windowMoveBufferY = Map.PlayerSightRadius + 1;

    int windowWidth = 25;
    int windowHeight = 20;
    int windowXOffset = Int32.MaxValue;
    int windowYOffset = Int32.MaxValue;

    protected override void OnInitialized()
    {
        // Fall back to the ASCII renderer by default if the (licensed, not
        // included in the repo) Ultimate Fantasy tileset hasn't been placed
        // under wwwroot/img - otherwise the tileset view would just render
        // empty/broken tiles. uf_terrain is used pervasively (floors/walls),
        // so its presence is a good proxy for "the tileset is installed".
        string tilesetProbeDirectory = Path.Combine(WebHostEnvironment.WebRootPath, "img", "uf_terrain");
        tilesetAvailable = Directory.Exists(tilesetProbeDirectory)
            && Directory.EnumerateFiles(tilesetProbeDirectory).Any();
        renderAscii = !tilesetAvailable;
    }

    void CenterViewportOnPlayer()
    {
        int optimalXOffset = game.Map.Player.X - windowWidth / 2;
        windowXOffset = Math.Clamp(optimalXOffset, 0, game.Map.Width - windowWidth);

        int optimalYOffset = game.Map.Player.Y - windowHeight / 2;
        windowYOffset = Math.Clamp(optimalYOffset, 0, game.Map.Height - windowHeight);
    }

    internal void OnClick(Decoration decoration)
    {
        if (session is null || game.Map.IsGameOver)
        {
            return;
        }

        session.Activate(soundManager!);

        decoration.OnUse?.Invoke();
        // NOTE: Rerender only gameobject? or rerender every decoration in tile...? Going for the latter, right now...
        // When I begin to do effecs, I may need to revisit this...
        game.Map.UpdateBlocksLight(decoration.GameObject.X, decoration.GameObject.Y, recomputeVisibility: true);
        game.Map.UpdateBlockMovement(decoration.GameObject.X, decoration.GameObject.Y);
        game.Map.RenderDecorations(decoration.GameObject.X, decoration.GameObject.Y);
        // TODO Don't I need to Render Moveables here also?
    }

    // Invoked from JS on every document-level keyup (see blazorroguefuncs.registerKeyup), rather
    // than a Blazor @onkeyup on the map div - keys drive the game regardless of which element has
    // focus, so there's no click-to-focus step and no input dropped after e.g. a button click.
    [JSInvokable]
    public async Task OnGlobalKeyUp(string key, string code, bool shiftKey, bool ctrlKey)
    {
        await KeyUp(key, code, shiftKey, ctrlKey);
        await InvokeAsync(StateHasChanged);
    }

    async Task KeyUp(string key, string code, bool shiftKey, bool ctrlKey)
    {
        if (session is null)
        {
            return;
        }

        // The help overlay is pure UI state, independent of game-over - toggle it first and
        // consume the keypress so it never also drives a game action (e.g. dismissing with
        // 'd' must not also move the player).
        if (showHelp)
        {
            // Opening the overlay requires Shift+/ on most layouts, which releases Shift a
            // moment later as its own keyup - ignore bare modifier releases so that doesn't
            // immediately close what it just opened.
            if (key is "Shift" or "Control" or "Alt" or "Meta")
            {
                return;
            }
            showHelp = false;
            return;
        }
        if (key == "?")
        {
            showHelp = true;
            return;
        }

        // Matching the letter (not Code="KeyA") keeps this at "the key labelled A" on any
        // keyboard layout. A view preference, not a game action, so it works even after game
        // over - unlike everything below this point. The browser's native Ctrl+A (select all)
        // is suppressed in the keydown handler - see registerKeyup in blazorrogue.js.
        if (ctrlKey && key.Equals("a", StringComparison.OrdinalIgnoreCase))
        {
            await ToggleRenderMode();
            return;
        }

        // A finished game accepts no further input; only the New game button remains live.
        if (game.Map.IsGameOver)
        {
            return;
        }

        // Re-point the static References hub at this session's game before any game logic runs:
        // another browser's session may have been the last to touch it. Also marks this session as
        // in use, so an actively played game is never evicted as idle.
        session.Activate(soundManager!);

        var mapBeforeAction = game.Map;

        if (OnKeyPress(key, code, shiftKey))
        {
            game.Map.PlayerTookTurn();

            // Rendered once, after both the player's and the monsters' turns are fully resolved,
            // so moveable decorations always reflect the final state of the turn - never a
            // half-finished snapshot from before the monsters moved.
            game.Map.RenderMoveables();

            if (game.Map != mapBeforeAction)
            {
                // Stairs replaced the whole map (and thus the player's coordinates) outright -
                // the incremental nudge below assumes step-by-step movement between neighbouring
                // tiles on the *same* map, so it can't be used here. Re-fit instead, in case the
                // new level's dimensions differ too.
                await FitMapToViewportAsync();
            }
            else
            {
                // adjust window
                // NOTE: Assumes step-by-step movement between neighbouring tiles, and optimizes for this (so does not handle, say teleportation)
                if (game.Map.Player.X - windowXOffset < windowMoveBufferX)
                {
                    windowXOffset--;
                }

                if (windowXOffset + windowWidth - game.Map.Player.X < windowMoveBufferX)
                {
                    windowXOffset++;
                }

                windowXOffset = Math.Clamp(windowXOffset, 0, game.Map.Width - windowWidth);

                if (game.Map.Player.Y - windowYOffset < windowMoveBufferY)
                {
                    windowYOffset--;
                }

                if (windowYOffset + windowHeight - game.Map.Player.Y < windowMoveBufferY)
                {
                    windowYOffset++;
                }

                windowYOffset = Math.Clamp(windowYOffset, 0, game.Map.Height - windowHeight);
            }
        }
    }

    bool OnKeyPress(string key, string keyCode, bool shiftKey)
    {
        char numKey;
        // System.Diagnostics.Debug.WriteLine($"{key}, {keyCode}, shift:{shiftKey}");

        if (keyCode.ToLower().StartsWith("numpad"))
        {
            numKey = keyCode[6];

            // handle shift + numpad
            if (key != numKey.ToString())
            {
                // we know shiftKey must have been held, as else we have, for all single digits X
                // key=="X" iff numKey=="NumpadX"
                shiftKey = true;
            }
        }

        // fast hacky support for laptop-movement
        else if (keyCode.ToLower() == "keyq")
        {
            numKey = '7';
        }
        else if (keyCode.ToLower() == "keyw")
        {
            numKey = '8';
        }
        else if (keyCode.ToLower() == "keye")
        {
            numKey = '9';
        }
        else if (keyCode.ToLower() == "keya")
        {
            numKey = '4';
        }
        else if (keyCode.ToLower() == "keys")
        {
            numKey = '5';
        }
        else if (keyCode.ToLower() == "keyd")
        {
            numKey = '6';
        }
        else if (keyCode.ToLower() == "keyz")
        {
            numKey = '1';
        }
        else if (keyCode.ToLower() == "keyx")
        {
            numKey = '2';
        }
        else if (keyCode.ToLower() == "keyc")
        {
            numKey = '3';
        }
        else
            return false;

        return game.Map.HandlePlayerAction(shiftKey, numKey);
    }
}
